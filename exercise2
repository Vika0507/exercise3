<?php
$animals = ['кот', 'собака', 'попугай'];

// Находим индекс элемента 'собака' и заменяем значение
$key = array_search('собака', $animals);
if ($key !== false) {
    $animals[$key] = 'свинка';
}

// Добавляем новый элемент в конец массива
$animals[] = 'хомяк';

print_r($animals);

echo "\n";